<%
  const r = data.report || {};
  const d = r.data || {};
  const att = d.attendance || {};
  const areas = d.areas || [];
  const goals = d.goals || [];
  const p = data.patient || {};
  const doc = data.doctor || {};
  const fmt = (dt) => { if (!dt) return ''; const m = /^(\d{4})-(\d{2})-(\d{2})/.exec(new Date(dt).toISOString()); return m ? `${m[3]}/${m[2]}/${m[1]}` : ''; };
  const esc = (s) => String(s || '');
  const statusTxt = { achieved: 'Alcançada', paused: 'Pausada', active: 'Em andamento' };
%>
<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="utf-8">
<title>Relatório mensal</title>
<style>
  * { box-sizing: border-box; }
  body { font-family: Arial, Helvetica, sans-serif; font-size: 12px; color: #111827; margin: 0; padding: 28px 34px; }
  header { display: flex; justify-content: space-between; align-items: flex-end; border-bottom: 2px solid #047857; padding-bottom: 10px; margin-bottom: 16px; }
  .brand { font-size: 18px; font-weight: 700; color: #047857; }
  .muted { color: #4b5563; }
  h1 { font-size: 16px; margin: 0 0 4px; }
  h2 { font-size: 13px; margin: 18px 0 6px; color: #065f46; text-transform: uppercase; letter-spacing: .03em; }
  .grid { display: flex; gap: 10px; }
  .kpi { flex: 1; border: 1px solid #e5e7eb; border-radius: 8px; padding: 8px 10px; }
  .kpi b { display: block; font-size: 18px; }
  table { width: 100%; border-collapse: collapse; }
  th, td { text-align: left; padding: 6px 8px; border-bottom: 1px solid #e5e7eb; vertical-align: top; }
  th { font-size: 11px; color: #4b5563; font-weight: 600; }
  .bar { height: 6px; background: #e5e7eb; border-radius: 3px; overflow: hidden; margin-top: 3px; }
  .bar i { display: block; height: 6px; background: #047857; }
  .up { color: #047857; font-weight: 700; } .down { color: #b45309; font-weight: 700; }
  p.text { white-space: pre-wrap; line-height: 1.5; margin: 0; }
  .draft { position: fixed; top: 40%; left: 0; right: 0; text-align: center; font-size: 64px; color: rgba(180,83,9,.12); transform: rotate(-20deg); }
  footer { margin-top: 36px; display: flex; justify-content: space-between; align-items: flex-end; }
  .sign { border-top: 1px solid #111827; width: 260px; padding-top: 4px; text-align: center; }
</style>
</head>
<body>
<% if (data.draft) { %><div class="draft">RASCUNHO</div><% } %>
<header>
  <div>
    <div class="brand">Clínica Fono Inova</div>
    <div class="muted">Relatório mensal de acompanhamento</div>
  </div>
  <div style="text-align:right">
    <h1><%= esc(p.fullName) %></h1>
    <div class="muted"><%= esc(data.monthLabel) %><% if (p.dateOfBirth) { %> · nasc. <%= fmt(p.dateOfBirth) %><% } %></div>
  </div>
</header>

<div class="grid">
  <div class="kpi"><span class="muted">Sessões com evolução</span><b><%= d.sessionsWithEvolution || 0 %></b></div>
  <div class="kpi"><span class="muted">Presença</span><b><%= att.rate != null ? att.rate + '%' : '—' %></b><span class="muted"><%= (att.attended || 0) === 1 ? '1 presença' : (att.attended || 0) + ' presenças' %> · <%= (att.missed || 0) === 1 ? '1 falta' : (att.missed || 0) + ' faltas' %></span></div>
  <div class="kpi"><span class="muted">Profissional</span><b style="font-size:13px"><%= esc(doc.fullName) %></b><span class="muted"><%= esc(doc.specialty) %></span></div>
</div>

<h2>Resumo do mês</h2>
<p class="text"><%= esc(r.summary) || 'Sem resumo.' %></p>

<% if (goals.length) { %>
<h2>Metas do plano (PEI)</h2>
<table>
  <tr><th>Meta</th><th style="width:110px">Situação</th><th style="width:150px">Avanço</th></tr>
  <% goals.forEach(g => { %>
  <tr>
    <td><b><%= esc(g.area) %></b> · <%= esc(g.description) %><% if (g.criterion) { %><br><span class="muted"><%= esc(g.criterion) %></span><% } %></td>
    <td><%= statusTxt[g.status] || 'Em andamento' %></td>
    <td><%= g.baseline %> → <%= g.current %> (alvo <%= g.target %>)<div class="bar"><i style="width:<%= g.progressPct || 0 %>%"></i></div></td>
  </tr>
  <% }) %>
</table>
<% } %>

<% if (areas.length) { %>
<h2>Áreas trabalhadas (0 a 10)</h2>
<table>
  <tr><th>Área</th><th style="width:90px">Início do mês</th><th style="width:90px">Fim do mês</th><th style="width:70px">Variação</th></tr>
  <% areas.forEach(a => { %>
  <tr><td><%= esc(a.name) %></td><td><%= a.first %></td><td><%= a.last %></td>
    <td class="<%= a.delta > 0 ? 'up' : a.delta < 0 ? 'down' : '' %>"><%= a.delta > 0 ? '+' + a.delta : a.delta %></td></tr>
  <% }) %>
</table>
<% } %>

<% if (r.nextSteps) { %>
<h2>Próximos passos</h2>
<p class="text"><%= esc(r.nextSteps) %></p>
<% } %>

<footer>
  <span class="muted">Gerado em <%= fmt(r.generatedAt || new Date()) %><% if (r.approvedAt) { %> · aprovado em <%= fmt(r.approvedAt) %><% } %></span>
  <div class="sign"><%= esc(doc.fullName) %><br><span class="muted"><%= esc(doc.licenseNumber) %></span></div>
</footer>
</body>
</html>
