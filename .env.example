
# ============================================
# FEATURE FLAGS - TRANSIÇÃO 4.0 EVENT-DRIVEN
# ============================================

# CREATE: Criar agendamento
# true = ativa fluxo 4.0
FF_CREATE_V2=false
# 0-100: porcentagem de canary (0 = desligado, 100 = todos)
FF_CREATE_PERCENTAGE=0

# COMPLETE: Finalizar sessão
FF_COMPLETE_V2=false
FF_COMPLETE_PERCENTAGE=0

# CANCEL: Cancelar agendamento  
FF_CANCEL_V2=false
FF_CANCEL_PERCENTAGE=0

# EMERGENCY ROLLBACK
# true = força todos os fluxos para legado imediatamente
FF_EMERGENCY_ROLLBACK=false

# Rollback Guard - Limite de erros
FF_ERROR_THRESHOLD=10        # erros por minuto
FF_ERROR_WINDOW=60           # janela de tempo em segundos

# ============================================
# Monitoramento de memória (observability)
# ============================================
# Cota de RAM do container. É ela que causa OOM kill — NÃO confundir com o heap
# do V8 (--max-old-space-size), que é bem maior e não é o teto real em produção.
# Detectado automaticamente via cgroup quando disponível; em plataformas onde a
# detecção falha (o log de boot avisa), defina manualmente.
#   Render Starter = 512 | Render Standard = 2048
MEMORY_LIMIT_MB=512
MEMORY_WARN_PERCENT=80       # status "warning" a partir deste % da cota
MEMORY_CRIT_PERCENT=92       # status "critical" a partir deste % da cota
